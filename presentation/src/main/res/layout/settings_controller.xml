<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings screen redesigned to match HTML mockup:
  Card-grouped sections with colored 32dp icon squares.
  Sections: Messaging · Categorisation · Appearance · Privacy & Security · Backup
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:id="@+id/preferences"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- ── Messaging ─────────────────────────────────────────── -->
        <dev.octoshrimpy.quik.common.widget.QkTextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_category_messaging" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:background="@drawable/settings_card_bg"
            android:clipToOutline="true">

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/delivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_check_white_24dp"
                app:title="@string/settings_delivery_title"
                app:summary="@string/settings_delivery_summary"
                app:widget="@layout/settings_switch_widget" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginStart="64dp" />

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_notifications_black_24dp"
                app:title="@string/settings_notifications_title"
                app:summary="@string/settings_notifications_summary" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginStart="64dp" />

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/delayed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_av_timer_black_24dp"
                app:title="@string/settings_delayed_title"
                app:widget="@layout/settings_switch_widget" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginStart="64dp" />

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/unreadAtTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_message_black_24dp"
                app:title="@string/settings_unread_at_top_title"
                app:summary="@string/settings_unread_at_top_summary"
                app:widget="@layout/settings_switch_widget" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginStart="64dp" />

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/mobileOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_person_black_24dp"
                app:title="@string/settings_mobile_only_title"
                app:summary="@string/settings_mobile_only_summary"
                app:widget="@layout/settings_switch_widget" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginStart="64dp" />

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/swipeActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_clear_black_24dp"
                app:title="@string/settings_swipe_actions_title"
                app:summary="@string/settings_swipe_actions_summary" />

        </LinearLayout>

        <!-- ── Categorisation ────────────────────────────────────── -->
        <dev.octoshrimpy.quik.common.widget.QkTextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_category_categorisation" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:background="@drawable/settings_card_bg"
            android:clipToOutline="true">

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/autoCategorize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_message_black_24dp"
                app:title="@string/settings_auto_categorize_title"
                app:summary="@string/settings_auto_categorize_summary"
                app:widget="@layout/settings_switch_widget" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginStart="64dp" />

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/financeEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_finance"
                app:title="@string/settings_finance_enabled_title"
                app:summary="@string/settings_finance_enabled_summary"
                app:widget="@layout/settings_switch_widget" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginStart="64dp" />

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/blocking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="blocking"
                app:icon="@drawable/ic_block_white_24dp"
                app:title="@string/settings_blocking_title"
                app:summary="@string/settings_blocking_summary" />

        </LinearLayout>

        <!-- ── Appearance ────────────────────────────────────────── -->
        <dev.octoshrimpy.quik.common.widget.QkTextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_category_appearance" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:background="@drawable/settings_card_bg"
            android:clipToOutline="true">

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_palette_black_24dp"
                app:title="@string/settings_theme_title"
                app:widget="@layout/settings_theme_widget" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginStart="64dp" />

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/night"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_star_black_24dp"
                app:title="@string/settings_night_title" />

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/nightStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:icon="@drawable/ic_star_black_24dp"
                app:title="@string/settings_night_start_title" />

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/nightEnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:icon="@drawable/ic_star_black_24dp"
                app:title="@string/settings_night_end_title" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginStart="64dp" />

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/textSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_format_size_black_24dp"
                app:title="@string/settings_text_size_title" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginStart="64dp" />

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_star_black_24dp"
                app:title="@string/settings_black_title"
                app:widget="@layout/settings_switch_widget" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginStart="64dp" />

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/autoColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_palette_black_24dp"
                app:title="@string/settings_automatic_colors_title"
                app:widget="@layout/settings_switch_widget" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginStart="64dp" />

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/systemFont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_short_text_black_24dp"
                app:title="@string/settings_system_font_title"
                app:widget="@layout/settings_switch_widget" />

        </LinearLayout>

        <!-- Hidden prefs kept for code compatibility — not shown in redesigned UI -->
        <dev.octoshrimpy.quik.common.widget.PreferenceView android:id="@+id/autoEmoji"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" app:title="Auto emoji" app:widget="@layout/settings_switch_widget" />
        <dev.octoshrimpy.quik.common.widget.PreferenceView android:id="@+id/signature"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" app:title="Signature" />
        <dev.octoshrimpy.quik.common.widget.PreferenceView android:id="@+id/showStt"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" app:title="STT" app:widget="@layout/settings_switch_widget" />
        <dev.octoshrimpy.quik.common.widget.PreferenceView android:id="@+id/unicode"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" app:title="Unicode" app:widget="@layout/settings_switch_widget" />
        <dev.octoshrimpy.quik.common.widget.PreferenceView android:id="@+id/longAsMms"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" app:title="Long as MMS" app:widget="@layout/settings_switch_widget" />
        <dev.octoshrimpy.quik.common.widget.PreferenceView android:id="@+id/mmsSize"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" app:title="MMS size" />
        <dev.octoshrimpy.quik.common.widget.PreferenceView android:id="@+id/messsageLinkHandling"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" app:title="Link handling" />

        <!-- ── Privacy & Security ─────────────────────────────────── -->
        <dev.octoshrimpy.quik.common.widget.QkTextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_category_privacy" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:background="@drawable/settings_card_bg"
            android:clipToOutline="true">

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/disableScreenshots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_screenshot"
                app:title="@string/settings_disable_screenshots_title"
                app:summary="@string/settings_diable_screenshots_summary"
                app:widget="@layout/settings_switch_widget" />

        </LinearLayout>

        <!-- ── Backup ─────────────────────────────────────────────── -->
        <dev.octoshrimpy.quik.common.widget.QkTextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_category_backup" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:background="@drawable/settings_card_bg"
            android:clipToOutline="true">

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/sync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_sync_black_24dp"
                app:title="@string/settings_sync_title"
                app:summary="@string/settings_sync_summary" />

            <ProgressBar
                android:id="@+id/syncingProgress"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:indeterminate="true" />

        </LinearLayout>

        <!-- ── About ──────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:background="@drawable/settings_card_bg"
            android:clipToOutline="true">

            <dev.octoshrimpy.quik.common.widget.PreferenceView
                android:id="@+id/about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_info_black_24dp"
                app:title="@string/settings_about_title" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
