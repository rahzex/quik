<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?android:attr/colorBackground">

    <!-- Icon circle -->
    <FrameLayout
        android:id="@+id/txnIcon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/rounded_rectangle_12dp">

        <ImageView
            android:id="@+id/txnIconImage"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_credit_card_black_24dp"
            tools:tint="#1A7F4B" />
    </FrameLayout>

    <!-- Title / meta -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="8dp">

        <dev.octoshrimpy.quik.common.widget.QkTextView
            android:id="@+id/txnTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorPrimary"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="UPI Transfer" />

        <dev.octoshrimpy.quik.common.widget.QkTextView
            android:id="@+id/txnMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="HDFC ·· 4821 · Ref 428192811" />

        <dev.octoshrimpy.quik.common.widget.QkTextView
            android:id="@+id/txnTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="?android:attr/textColorTertiary"
            android:layout_marginTop="1dp"
            tools:text="8:12 AM" />

    </LinearLayout>

    <!-- Amount -->
    <dev.octoshrimpy.quik.common.widget.QkTextView
        android:id="@+id/txnAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="−₹4,200" />

</LinearLayout>

