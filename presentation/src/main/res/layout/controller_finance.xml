<?xml version="1.0" encoding="utf-8"?>
<!--
  Finance Dashboard screen — matches HTML mockup Phone 3.
  Structure:
    ① Summary header: "Finance" title + month switcher pills
    ② Stat grid: Spent (red) | Received (green)
    ③ Net-saved card with progress bar
    ④ Accounts section (RecyclerView)
    ⑤ Upcoming bills section (RecyclerView)
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Summary header: spec .summary-top { background: var(-surface) } -->
        <LinearLayout
            android:id="@+id/summaryTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="?android:attr/colorBackground">

            <!-- Title row + month switcher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <dev.octoshrimpy.quik.common.widget.QkTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/finance_title"
                    android:textSize="24sp"
                    android:textStyle="normal"
                    android:letterSpacing="-0.03"
                    android:textColor="?android:attr/textColorPrimary" />

                <!-- Month pill switcher — 20dp radius, surface3 fill, 1dp border, 3dp inner padding -->
                <LinearLayout
                    android:id="@+id/monthSwitcher"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/finance_month_switcher_bg"
                    android:padding="3dp" />

            </LinearLayout>

            <!-- ② Stat grid: 2-col -->
            <LinearLayout
                android:id="@+id/statGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Spent card -->
                <LinearLayout
                    android:id="@+id/cardSpent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/finance_card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/rounded_rectangle_8dp"
                            android:backgroundTint="@color/finance_red_bg"
                            android:layout_marginEnd="8dp">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_trending_up_black_24dp"
                                android:tint="@color/finance_red_text" />
                        </FrameLayout>

                        <dev.octoshrimpy.quik.common.widget.QkTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/finance_spent"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary" />
                    </LinearLayout>

                    <dev.octoshrimpy.quik.common.widget.QkTextView
                        android:id="@+id/statSpent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/finance_red_text"
                        tools:text="₹24.1k" />

                </LinearLayout>

                <!-- Received card -->
                <LinearLayout
                    android:id="@+id/cardReceived"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/finance_card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/rounded_rectangle_8dp"
                            android:backgroundTint="@color/finance_green_bg"
                            android:layout_marginEnd="8dp">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_trending_down_black_24dp"
                                android:tint="@color/finance_green_text" />
                        </FrameLayout>

                        <dev.octoshrimpy.quik.common.widget.QkTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/finance_received"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary" />
                    </LinearLayout>

                    <dev.octoshrimpy.quik.common.widget.QkTextView
                        android:id="@+id/statReceived"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/finance_green_text"
                        tools:text="₹36.0k" />

                </LinearLayout>

            </LinearLayout>

            <!-- ③ Net-saved card -->
            <LinearLayout
                android:id="@+id/netCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/finance_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <dev.octoshrimpy.quik.common.widget.QkTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/finance_net_saved"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <dev.octoshrimpy.quik.common.widget.QkTextView
                        android:id="@+id/netAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/finance_green_text"
                        tools:text="+₹11,900" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/spentProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progressDrawable="@drawable/finance_progress_drawable"
                    tools:progress="40" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <dev.octoshrimpy.quik.common.widget.QkTextView
                        android:id="@+id/progressSpentLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="10sp"
                        android:textColor="@color/finance_red_text"
                        tools:text="Spent 40%" />

                    <dev.octoshrimpy.quik.common.widget.QkTextView
                        android:id="@+id/progressSavedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="@color/finance_green_text"
                        tools:text="Saved 60%" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ④ Accounts section -->
        <LinearLayout
            android:id="@+id/sectionAccounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <dev.octoshrimpy.quik.common.widget.QkTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/finance_accounts"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.05" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/accountsRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/finance_account_list_item" />

            <dev.octoshrimpy.quik.common.widget.QkTextView
                android:id="@+id/accountsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/finance_no_accounts"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorTertiary"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- ⑤ Upcoming bills section -->
        <LinearLayout
            android:id="@+id/sectionUpcoming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <dev.octoshrimpy.quik.common.widget.QkTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/finance_upcoming"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.05" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/upcomingRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/finance_upcoming_list_item" />

            <dev.octoshrimpy.quik.common.widget.QkTextView
                android:id="@+id/upcomingEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/finance_no_upcoming"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorTertiary"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

