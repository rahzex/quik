<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 1 redesign: Matches HTML mockup .inbox-head structure:
  - Title row: "Messages" + search icon + overflow icon
  - Search bar (always visible below title)
  - Category tabs with 2dp bottom underline indicator
  - Conversation list
  - Finance placeholder
  - Bottom navigation bar
  - FAB above bottom nav
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <!-- ── Inbox header matching HTML .inbox-head ── -->
    <LinearLayout
        android:id="@+id/inboxHead"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?android:attr/windowBackground"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Title row: "Messages" + search icon + overflow icon -->
        <LinearLayout
            android:id="@+id/inboxTitleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <dev.octoshrimpy.quik.common.widget.QkTextView
                android:id="@+id/toolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_title_messages"
                android:textSize="24sp"
                android:textStyle="normal"
                android:letterSpacing="-0.03"
                android:textColor="?android:attr/textColorPrimary" />

            <!-- Search toggle icon -->
            <FrameLayout
                android:id="@+id/searchIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/rounded_rectangle_8dp"
                android:backgroundTint="?attr/bubbleColor"
                android:layout_marginEnd="6dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search_black_24dp"
                    android:tint="?android:attr/textColorSecondary"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <!-- Overflow icon -->
            <FrameLayout
                android:id="@+id/overflowIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/rounded_rectangle_8dp"
                android:backgroundTint="?attr/bubbleColor">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_more_vert_black_24dp"
                    android:tint="?android:attr/textColorSecondary"
                    android:scaleType="fitCenter" />
            </FrameLayout>

        </LinearLayout>

        <!-- Search bar (always visible, matching HTML .search-bar) -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/rounded_rectangle_8dp"
            android:backgroundTint="?attr/bubbleColor"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_search_black_24dp"
                android:tint="?android:attr/textColorTertiary"
                android:scaleType="fitCenter"
                android:layout_marginEnd="7dp" />

            <dev.octoshrimpy.quik.common.widget.QkEditText
                android:id="@+id/toolbarSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/main_search_hint"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorTertiary" />

        </LinearLayout>

        <!-- Category tabs (matching HTML .msg-tabs) -->
        <HorizontalScrollView
            android:id="@+id/categoryTabsScroll"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/categoryTabsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />

        </HorizontalScrollView>

    </LinearLayout>

    <!-- 1dp divider below header -->
    <View
        android:id="@+id/tabsDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/inboxHead" />

    <!-- Conversation list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabsDivider" />

    <!-- Empty view -->
    <dev.octoshrimpy.quik.common.widget.QkTextView
        android:id="@+id/empty"
        style="@style/TextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabsDivider"
        tools:text="No messages" />

    <!-- Finance placeholder -->
    <LinearLayout
        android:id="@+id/financePlaceholder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabsDivider">

        <dev.octoshrimpy.quik.common.widget.QkTextView
            style="@style/TextSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/main_finance_placeholder" />

    </LinearLayout>

    <!-- Syncing overlay ViewStub -->
    <ViewStub
        android:id="@+id/syncing"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout="@layout/main_syncing"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabsDivider" />

    <!-- Permission snackbar ViewStub -->
    <ViewStub
        android:id="@+id/snackbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout="@layout/main_permission_hint"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- FAB — accent bg, rounded rect (matching HTML .fab border-radius:16px) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/compose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:src="@drawable/ic_add_black_24dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemTextColor="@color/bottom_nav_item"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

