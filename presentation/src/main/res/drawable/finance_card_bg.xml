<?xml version="1.0" encoding="utf-8"?>
<!--
  Finance card background.
    Fill:   @color/surface_card  (light #FFFFFF / dark #141414, spec surface token)
    Stroke: @color/settings_card_stroke (night-aware border)
    Radius: 12dp (spec radius)
  Replaces rounded_rectangle_12dp + android:backgroundTint on Finance stat,
  net-saved, account, and upcoming-bill cards.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <stroke
                android:width="1dp"
                android:color="@color/settings_card_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>


